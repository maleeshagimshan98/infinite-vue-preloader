{
  "name": "infinite-vue-preloader",
  "version": "2.0.0",
  "description": "Vue Preloader is a simple and customizable Vue component that allows you to display a preloader or loading indicator while your content is being loaded. This wrapper component provides a convenient way to show a loading animation or message to users during asynchronous operations.",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maleeshagimshan98/infinite-vue-preloader"
  },
  "scripts": {
    "dev": "vite serve --config vite.config.dev.ts",
    "build": "vite build --config vite.config.build.ts && vue-tsc --emitDeclarationOnly",
    "test": "jest",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ],
    "*.{json}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.0",
    "@vue/tsconfig": "^0.5.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.1",
    "vite": "^6.3.3",
    "vue": "^3.2.41",
    "vue-tsc": "^1.8.27"
  },
  "keywords": [
    "preloader",
    "pre-loader",
    "vue component",
    "component",
    "vue"
  ],
  "author": {
    "name": "Maleesha Gimshan",
    "url": "https://github.com/maleeshagimshan98"
  },
  "license": "MIT"
}
